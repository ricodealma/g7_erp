generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  OPERATOR
}

enum ProductCategory {
  SNACK
  DRINK
}

/// COUNTABLE: saldo numérico com baixa automática (bebidas, lanches com rendimento conhecido).
/// UNCOUNTABLE: sem saldo; o operador marca "Esgotado" manualmente (macarrão, marmitas).
enum StockControl {
  COUNTABLE
  UNCOUNTABLE
}

enum EventStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  AWAITING_CONFIRMATION
  PENDING
  READY
  DELIVERED
  CANCELED
}

enum OrderOrigin {
  COUNTER
  SELF_SERVICE
}

enum PaymentMethod {
  PIX
  CASH
  PAY_LATER
}

enum PaymentStatus {
  PENDING
  PAID
}

enum OrderItemKind {
  PRODUCT
  COMBO
}

enum StockMovementType {
  RESTOCK
  SALE
  CANCELLATION
  ADJUSTMENT
}

// ============================================
// CONFIGURAÇÃO E ACESSO
// ============================================

/// Perfil de acesso vinculado ao usuário do Supabase Auth (id = auth.users.id).
model Profile {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(255)
  role      Role     @default(OPERATOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ordersCreated  Order[]         @relation("OrderCreatedBy")
  ordersSettled  Order[]         @relation("OrderSettledBy")
  stockMovements StockMovement[]
  eventsClosed   Event[]         @relation("EventClosedBy")

  @@map("profiles")
}

/// Configurações globais (linha única, id = 1).
model Settings {
  id            Int      @id @default(1)
  pixKey        String   @map("pix_key") @db.VarChar(140)
  pixMerchant   String   @map("pix_merchant") @db.VarChar(25)
  pixCity       String   @map("pix_city") @db.VarChar(15)
  receiptHeader String   @map("receipt_header") @db.VarChar(32)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

// ============================================
// CATÁLOGO
// ============================================

model Product {
  id                String          @id @default(uuid(7)) @db.Uuid
  name              String          @unique @db.VarChar(80)
  category          ProductCategory
  price             Decimal         @db.Decimal(10, 2)
  stockControl      StockControl    @map("stock_control")
  /// Saldo atual; nulo para produtos UNCOUNTABLE.
  stockQuantity     Int?            @map("stock_quantity")
  lowStockThreshold Int?            @map("low_stock_threshold")
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  eventMenu       EventMenuItem[]
  comboOptions    ComboOption[]
  orderItems      OrderItem[]
  orderComponents OrderItemComponent[]
  stockMovements  StockMovement[]

  @@index([category, active])
  @@map("products")
}

/// Combo de preço fixo: 1 lanche + 1 bebida, escolhidos entre as opções permitidas.
model Combo {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(80)
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  options    ComboOption[]
  orderItems OrderItem[]

  @@map("combos")
}

model ComboOption {
  comboId   String  @map("combo_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([comboId, productId])
  @@map("combo_options")
}

// ============================================
// EVENTO / SESSÃO DE VENDAS
// ============================================

model Event {
  id            String      @id @default(uuid(7)) @db.Uuid
  name          String      @db.VarChar(80)
  date          DateTime    @db.Date
  status        EventStatus @default(OPEN)
  /// Último número de pedido emitido no evento (numeração reinicia por evento).
  orderSequence Int         @default(0) @map("order_sequence")
  /// Fechamento de caixa: dinheiro esperado (congelado no encerramento) x contado.
  expectedCash  Decimal?    @map("expected_cash") @db.Decimal(10, 2)
  countedCash   Decimal?    @map("counted_cash") @db.Decimal(10, 2)
  closingNotes  String?     @map("closing_notes")
  closedAt      DateTime?   @map("closed_at") @db.Timestamptz
  closedById    String?     @map("closed_by_id") @db.Uuid
  closedBy      Profile?    @relation("EventClosedBy", fields: [closedById], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  menu           EventMenuItem[]
  orders         Order[]         @relation("OrderEvent")
  settlements    Order[]         @relation("OrderSettledEvent")
  stockMovements StockMovement[]

  @@index([status])
  @@index([date])
  @@map("events")
}

/// Lanches ativos no cardápio do dia de um evento.
model EventMenuItem {
  eventId   String  @map("event_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  soldOut   Boolean @default(false) @map("sold_out")
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([eventId, productId])
  @@map("event_menu_items")
}

// ============================================
// PEDIDOS
// ============================================

model Order {
  id             String         @id @default(uuid(7)) @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  event          Event          @relation("OrderEvent", fields: [eventId], references: [id], onDelete: Restrict)
  number         Int
  customerName   String         @map("customer_name") @db.VarChar(80)
  status         OrderStatus    @default(PENDING)
  origin         OrderOrigin    @default(COUNTER)
  isReservation  Boolean        @default(false) @map("is_reservation")
  notes          String?        @db.VarChar(280)
  total          Decimal        @db.Decimal(10, 2)
  paymentMethod  PaymentMethod  @map("payment_method")
  paymentStatus  PaymentStatus  @map("payment_status")
  /// Forma usada na quitação de um pedido PAY_LATER.
  settledWith    PaymentMethod? @map("settled_with")
  /// Evento aberto no momento da quitação (o dinheiro entra no caixa daquele evento).
  settledEventId String?        @map("settled_event_id") @db.Uuid
  settledEvent   Event?         @relation("OrderSettledEvent", fields: [settledEventId], references: [id], onDelete: Restrict)
  settledById    String?        @map("settled_by_id") @db.Uuid
  settledBy      Profile?       @relation("OrderSettledBy", fields: [settledById], references: [id])
  amountReceived Decimal?       @map("amount_received") @db.Decimal(10, 2)
  paidAt         DateTime?      @map("paid_at") @db.Timestamptz
  canceledAt     DateTime?      @map("canceled_at") @db.Timestamptz
  createdById    String?        @map("created_by_id") @db.Uuid
  createdBy      Profile?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  items          OrderItem[]
  stockMovements StockMovement[]

  @@unique([eventId, number])
  @@index([eventId, status])
  @@index([paymentStatus])
  @@index([settledEventId])
  @@map("orders")
}

model OrderItem {
  id          String        @id @default(uuid(7)) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        OrderItemKind
  productId   String?       @map("product_id") @db.Uuid
  product     Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  comboId     String?       @map("combo_id") @db.Uuid
  combo       Combo?        @relation(fields: [comboId], references: [id], onDelete: Restrict)
  /// Nome do produto/combo no momento da venda (histórico imutável para reimpressão).
  description String        @db.VarChar(80)
  quantity    Int
  unitPrice   Decimal       @map("unit_price") @db.Decimal(10, 2)
  notes       String?       @db.VarChar(140)

  components OrderItemComponent[]

  @@index([orderId])
  @@map("order_items")
}

/// Produtos escolhidos dentro de um item do tipo COMBO (1 por unidade do combo).
model OrderItemComponent {
  orderItemId String    @map("order_item_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  description String    @db.VarChar(80)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([orderItemId, productId])
  @@map("order_item_components")
}

// ============================================
// ESTOQUE
// ============================================

/// Livro de movimentações: quantity positiva = entrada, negativa = saída.
model StockMovement {
  id          String            @id @default(uuid(7)) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Int
  eventId     String?           @map("event_id") @db.Uuid
  event       Event?            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orderId     String?           @map("order_id") @db.Uuid
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdById String?           @map("created_by_id") @db.Uuid
  createdBy   Profile?          @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([productId, createdAt])
  @@index([eventId])
  @@map("stock_movements")
}
