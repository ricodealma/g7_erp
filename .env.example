# --- Banco de dados ---------------------------------------------------------
# Desenvolvimento local (docker compose up -d): as duas URLs apontam para o mesmo banco.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/g7_erp"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/g7_erp"

# Produção (Supabase):
# Runtime -> Supavisor modo transação (porta 6543)
# DATABASE_URL="postgres://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres"
# CLI (migrations/seed) -> Supavisor modo sessão (porta 5432)
# DIRECT_URL="postgres://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth ----------------------------------------------------------
# Local: `pnpm supabase:start` e copie API_URL / PUBLISHABLE_KEY / SECRET_KEY de `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Somente no servidor: tela de usuários do painel admin e `pnpm user:create`.
# Nunca use o prefixo NEXT_PUBLIC_ nem exponha no cliente.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# --- Cron keep-alive (mínimo 16 caracteres; gere com: openssl rand -hex 32) --
CRON_SECRET="troque-por-um-segredo-aleatorio"

# Opcional (dev): IPs da rede local liberados para testar pelo celular, ex.: 192.168.0.10
# DEV_ALLOWED_ORIGINS=""
